# ==========================================
# ResumePilot AI - Root Environment Config
# ==========================================

# PostgreSQL Database Settings
POSTGRES_USER=resumepilot_user
POSTGRES_PASSWORD=resumepilot_secure_pass
POSTGRES_DB=resumepilot_db
POSTGRES_PORT=5432

# Backend API Configuration
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change_this_to_a_strong_random_secret
JWT_SECRET_KEY=change_this_to_a_different_strong_random_secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
DATABASE_URL=postgresql://resumepilot_user:resumepilot_secure_pass@localhost:5432/resumepilot_db

# Gemini AI API Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
