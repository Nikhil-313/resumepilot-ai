FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change_this_to_a_strong_random_secret
JWT_SECRET_KEY=change_this_to_a_different_strong_random_secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
DATABASE_URL=postgresql://resumepilot_user:resumepilot_secure_pass@localhost:5432/resumepilot_db
GEMINI_API_KEY=your_google_gemini_api_key_here
MAX_CONTENT_LENGTH=10485760 # 10MB file limit
UPLOAD_FOLDER=uploads
